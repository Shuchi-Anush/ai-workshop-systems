# syntax=docker/dockerfile:1

# Stage 1: Builder
FROM python:3.11-slim AS builder

WORKDIR /build

# Install uv
RUN pip install --no-cache-dir uv

# Copy workspace configuration and lockfile
COPY pyproject.toml uv.lock ./

# Copy all source code for packages and apps
COPY packages/ packages/
COPY apps/ apps/

# Build wheels for all packages and apps (no editable installs)
RUN uv build --all

# Stage 2: Production Runtime
FROM python:3.11-slim

WORKDIR /app

# Copy built wheels from builder
COPY --from=builder /build/dist/*.whl /tmp/wheels/

# Install the wheels without uv sync, purely isolated
RUN pip install --no-cache-dir /tmp/wheels/*.whl

# Ensure uvicorn is available (it should be installed via dependencies)
# Run the API
EXPOSE 8000

CMD ["uvicorn", "apps.resume_analyzer.backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
