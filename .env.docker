# Docker Compose Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Ollama Services (Docker host networking)
OLLAMA_HOST=http://ollama:11434

# Vector DB Configuration (Mock/Docker volume)
VECTOR_DB_URL=sqlite:////data/vector_db/docker_mock.db
VECTOR_DB_TYPE=mock

# Relational DB Configuration (Docker host networking)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_workshop

# Redis Configuration (Docker host networking)
REDIS_HOST=redis
REDIS_PORT=6379

# Mock Settings
USE_MOCK_EMBEDDER=true
USE_MOCK_VECTOR_DB=true